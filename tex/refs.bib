	eprint = {2006.10256},
	journal = {\nat},
	keywords = {Computer Science - Mathematical Software, Statistics - Computation},
	month = sep,
	number = {7825},
	pages = {357-362},
	primaryclass = {cs.MS},
	title = {{Array programming with NumPy}},
