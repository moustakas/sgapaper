	title = {{Deep Synoptic Array Science: First FRB and Host Galaxy Catalog}},
	volume = {967},
	year = 2024,
	bdsk-file-1 = {},
	bdsk-url-1 = {https://doi.org/10.3847/1538-4357/ad3736},
