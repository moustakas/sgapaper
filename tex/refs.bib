@article{said20a,
	abstract = {Measurement of peculiar velocities by combining redshifts and distance indicators is a powerful way to measure the growth rate of a cosmic structure and test theories of gravity at low redshift. Here we constrain the growth rate of the structure by comparing observed Fundamental Plane peculiar velocities for 15 894 galaxies from the 6dF Galaxy Survey (6dFGS) and Sloan Digital Sky Survey (SDSS) with predicted velocities and densities from the 2M++ redshift survey. We measure the velocity scale parameter $\beta \equiv  \Omega _ \rm m ^\gamma  /b = 0.372^ +0.034 _ -0.050 $ and $0.314^ +0.031 _ -0.047 $ for 6dFGS and SDSS, respectively, where Ω<SUB>m</SUB> is the mass density parameter, γ is the growth index, and b is the bias parameter normalized to the characteristic luminosity of galaxies, L*. Combining 6dFGS and SDSS, we obtain β = 0.341 $\pm$ 0.024, implying that the amplitude of the product of the growth rate and the mass fluctuation amplitude is fσ<SUB>8</SUB> = 0.338 $\pm$ 0.027 at an effective redshift z = 0.035. Adopting Ω<SUB>m</SUB> = 0.315 $\pm$ 0.007, as favoured by Planck and using γ = 6/11 for General Relativity and γ = 11/16 for DGP gravity, we get $S_8(z=0) = \sigma _8 \sqrt \Omega _ \rm m /0.3  =0.637 \pm 0.054$ and 0.741 $\pm$ 0.062 for GR and DGP, respectively. This measurement agrees with other low-redshift probes of large-scale structure but deviates by more than 3σ from the latest Planck CMB measurement. Our results favour values of the growth index γ &gt; 6/11 or a Hubble constant H<SUB>0</SUB> &gt; 70 km s<SUP>-1</SUP> Mpc<SUP>-1</SUP> or a fluctuation amplitude σ<SUB>8</SUB> &lt; 0.8 or some combination of these. Imminent redshift surveys such as Taipan, DESI, WALLABY, and SKA1-MID will help to resolve this tension by measuring the growth rate of cosmic structure to 1 per cent in the redshift range 0 &lt; z &lt; 1.},
	adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	adsurl = {https://ui.adsabs.harvard.edu/abs/2020MNRAS.497.1275S},
	archiveprefix = {arXiv},
	author = {{Said}, Khaled and {Colless}, Matthew and {Magoulas}, Christina and {Lucey}, John R. and {Hudson}, Michael J.},
	date-added = {2026-07-16 08:02:15 -0400},
	date-modified = {2026-07-16 08:02:15 -0400},
	eprint = {2007.04993},
	journal = {\mnras},
	keywords = {galaxies: distances and redshifts, cosmology: observations, large-scale structure of Universe; cosmological parameters, Astrophysics - Cosmology and Nongalactic Astrophysics, Astrophysics - Astrophysics of Galaxies},
	month = sep,
	number = {1},
	pages = {1275-1293},
	primaryclass = {astro-ph.CO},
	title = {{Joint analysis of 6dFGS and SDSS peculiar velocities for the growth rate of cosmic structure and tests of gravity}},
	volume = {497},
	year = 2020,
	bdsk-file-1 = {},
	bdsk-url-1 = {https://doi.org/10.1093/mnras/staa2032},
	bdsk-url-2 = {https://ui.adsabs.harvard.edu/abs/2020MNRAS.497.1275S},
	bdsk-url-3 = {https://ui.adsabs.harvard.edu/link_gateway/2020MNRAS.497.1275S/EPRINT_HTML}}

@article{saulder23a,
	abstract = {We describe the target selection and characteristics of the DESI Peculiar Velocity Survey, the largest survey of peculiar velocities (PVs) using both the fundamental plane (FP) and the Tully-Fisher (TF) relationship planned to date. We detail how we identify suitable early-type galaxies (ETGs) for the FP and suitable late-type galaxies (LTGs) for the TF relation using the photometric data provided by the DESI Legacy Imaging Survey DR9. Subsequently, we provide targets for 373 533 ETGs and 118 637 LTGs within the Dark Energy Spectroscopic Instrument (DESI) 5-yr footprint. We validate these photometric selections using existing morphological classifications. Furthermore, we demonstrate using survey validation data that DESI is able to measure the spectroscopic properties to sufficient precision to obtain PVs for our targets. Based on realistic DESI fibre assignment simulations and spectroscopic success rates, we predict the final DESI PV Survey will obtain ~133 000 FP-based and ~53 000 TF-based PV measurements over an area of 14 000 deg<SUP>2</SUP>. We forecast the ability of using these data to measure the clustering of galaxy positions and PVs from the combined DESI PV and Bright Galaxy Surveys (BGS), which allows for cancellation of cosmic variance at low redshifts. With these forecasts, we anticipate a 4 per cent statistical measurement on the growth rate of structure at z &lt; 0.15. This is over two times better than achievable with redshifts from the BGS alone. The combined DESI PV and BGS will enable the most precise tests to date of the time and scale dependence of large-scale structure growth at z &lt; 0.15.},
	adsnote = {Provided by the SAO/NASA Astrophysics Data System},
	adsurl = {https://ui.adsabs.harvard.edu/abs/2023MNRAS.525.1106S},
	archiveprefix = {arXiv},
	author = {{Saulder}, Christoph and {Howlett}, Cullan and {Douglass}, Kelly A. and {Said}, Khaled and {BenZvi}, Segev and {Ahlen}, Steven and {Aldering}, Greg and {Bailey}, Stephen and {Brooks}, David and {Davis}, Tamara M. and {de la Macorra}, Axel and {Dey}, Arjun and {Font-Ribera}, Andreu and {Forero-Romero}, Jaime E. and {Gontcho A. Gontcho}, Satya and {Honscheid}, Klaus and {Kim}, Alex G. and {Kisner}, Theodore and {Kremin}, Anthony and {Landriau}, Martin and {Levi}, Michael E. and {Lucey}, John and {Meisner}, Aaron M. and {Miquel}, Ramon and {Moustakas}, John and {Myers}, Adam D. and {Palanque-Delabrouille}, Nathalie and {Percival}, Will and {Poppett}, Claire and {Prada}, Francisco and {Qin}, Fei and {Schubnell}, Michael and {Tarl{\'e}}, Gregory and {Vargas Maga{\~n}a}, Mariana and {Weaver}, Benjamin Alan and {Zhou}, Rongpu and {Zhou}, Zhimin and {Zou}, Hu},
	date-added = {2025-01-11 21:25:25 -0500},
